{
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/",
      "destination": "/src/index.html"
    },
    {
      "source": "/screener.js",
      "destination": "/src/screener.js"
    },
    {
      "source": "/style.css",
      "destination": "/src/style.css"
    }
  ]
}